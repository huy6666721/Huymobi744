local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({Name = "huy367 hub", HidePremium = false, SaveConfig = true, ConfigFolder = "OrionTest"})

-- ==================== TRANG CHỦ ====================
local TabHome = Window:MakeTab({
	Name = "Trang Chủ",
	Icon = "rbxassetid://4483345998",
	PremiumOnly = false
})

TabHome:AddLabel("Chào mừng " .. game.Players.LocalPlayer.Name .. " đến với huy367 hub!")

TabHome:AddButton({
	Name = "Bật Chức Năng Tổng Hợp",
	Callback = function()
		print("Đã kích hoạt hệ thống!")
	end    
})

-- ==================== TÙY CHỈNH NHÂN VẬT ====================
local TabPlayer = Window:MakeTab({
	Name = "Người Chơi",
	Icon = "rbxassetid://4483345998",
	PremiumOnly = false
})

-- Thanh trượt thay đổi tốc độ chạy
TabPlayer:AddSlider({
	Name = "Tốc độ chạy (WalkSpeed)",
	Min = 16,
	Max = 500,
	Default = 16,
	Color = Color3.fromRGB(255,255,255),
	Increment = 1,
	ValueName = "Speed",
	Callback = function(Value)
		game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
	end    
})

-- Thanh trượt thay đổi độ cao khi nhảy
TabPlayer:AddSlider({
	Name = "Độ cao nhảy (JumpPower)",
	Min = 50,
	Max = 500,
	Default = 50,
	Color = Color3.fromRGB(255,255,255),
	Increment = 1,
	ValueName = "Power",
	Callback = function(Value)
		game.Players.LocalPlayer.Character.Humanoid.JumpPower = Value
	end    
})

-- Bật/Tắt tính năng nhìn xuyên tường (Infinite Zoom)
TabPlayer:AddToggle({
	Name = "Mở rộng khoảng cách Camera",
	Default = false,
	Callback = function(Value)
		if Value then
			game.Players.LocalPlayer.CameraMaxZoomDistance = 100000
		else
			game.Players.LocalPlayer.CameraMaxZoomDistance = 400
		end
	end
})

-- ==================== TỰ ĐỘNG (KHUNG CHỨC NĂNG) ====================
local TabAutomation = Window:MakeTab({
	Name = "Tự Động (Auto)",
	Icon = "rbxassetid://4483345998",
	PremiumOnly = false
})

-- Khung thiết lập Auto Farm
TabAutomation:AddToggle({
	Name = "Tự động đánh (Auto Farm)",
	Default = false,
	Callback = function(Value)
		_G.AutoFarm = Value
		while _G.AutoFarm do
			task.wait(0.5)
			print("Đang quét mục tiêu...")
		end
	end
})

-- Cài đặt phím tắt để Ẩn/Hiện Menu nhanh (Mặc định là phím LeftControl)
OrionLib:MakeBind({
	Name = "Phím tắt ẩn/hiện Menu",
	Default = Enum.KeyCode.LeftControl,
	NoIcon = false,
	Callback = function()
		-- Hệ thống tự động xử lý ẩn giao diện của OrionLib
	end    
})

OrionLib:Init()
